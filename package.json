{
  "name": "morion",
  "version": "1.4.12",
  "description": "A local notebook that doubles as an MCP memory server for any LLM.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://morion.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miksushko/morion-oss.git"
  },
  "bugs": {
    "url": "https://github.com/miksushko/morion-oss/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "morion": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "MORION_HTTP_PORT=7778 tsx watch src/server/index.ts",
    "dev:web": "vite",
    "serve": "node dist/server/index.js",
    "mcp": "tsx src/cli/index.ts mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:mcpb": "node scripts/package-mcpb.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^1.13.7",
    "@huggingface/transformers": "^3.0.2",
    "@joplin/turndown-plugin-gfm": "^1.0.64",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@monaco-editor/react": "^4.7.0",
    "@openai/codex-sdk": "^0.130.0",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-table-cell": "^3.22.5",
    "@tiptap/extension-table-header": "^3.22.5",
    "@tiptap/extension-table-row": "^3.22.5",
    "@tiptap/extension-task-item": "^3.22.5",
    "@tiptap/extension-task-list": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@types/dagre": "^0.7.54",
    "@types/turndown": "^5.0.6",
    "@xyflow/react": "^12.10.2",
    "better-sqlite3": "^12.8.0",
    "commander": "^12.1.0",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.0",
    "file-type": "^19.6.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.14",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.1",
    "smol-toml": "^1.6.1",
    "sqlite-vec": "^0.1.6",
    "turndown": "^7.2.4",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "happy-dom": "^20.8.9",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "tiptap-markdown": "^0.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "overrides": {
    "protobufjs": "^7.5.5"
  }
}
