# Morion — optional environment variables (browser-local / server runs).
# Copy to .env and uncomment what you need. Everything has a sane default;
# Morion runs with an empty .env.

# Where the SQLite database + config live. Defaults to your OS config dir
# (e.g. ~/Library/Application Support/dev.morion.notebook on macOS).
# MORION_CONFIG_DIR=/Users/you/Documents/morion-data

# Sidecar HTTP port. `npm run dev` already sets 7778; production `serve`
# defaults to 7777.
# MORION_HTTP_PORT=7778

# Loopback auth token. Leave UNSET for browser-local / single-user dev —
# an empty token disables the auth gate. Set a value only if you expose the
# sidecar beyond localhost.
# MORION_API_TOKEN=

# --- Mo agent (optional) ----------------------------------------------------
# Mo is free but needs an LLM provider key. Configure ONE backend, then enable
# Mo per folder in the UI. (You can also set keys in Settings instead of here.)
# MORION_OPENROUTER_API_KEY=
# MORION_ANTHROPIC_API_KEY=
# MORION_OPENAI_API_KEY=
# MORION_GROQ_API_KEY=
# Local models via Ollama:
# MORION_OLLAMA_BASE_URL=http://127.0.0.1:11434
